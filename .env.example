# Copy to .env. Never commit .env.
#
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated. The first key encrypts; all keys decrypt, which allows rotation.
SOCIAL_TOKEN_ENCRYPTION_KEYS=change-me

# Google Cloud: YouTube Data API v3 and an OAuth client of type "Web application".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8765/oauth/callback
# Uploads stay private until this is true, as this project's own policy.
YOUTUBE_PROJECT_AUDITED=false
# YouTube stopped requiring this on 2 Nov 2026. Set false to allow public uploads when unaudited.
YOUTUBE_FORCE_PRIVATE_WHEN_UNAUDITED=true
YOUTUBE_DAILY_UPLOAD_LIMIT=100

# Real providers. For a free local run with no keys, use the fake ones below instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=
# LLM_PROVIDER=providers.fake.FakeLLM
# TTS_PROVIDER=providers.fake.FakeTTS
# STOCK_PROVIDER=providers.fake.FakeStock

GENERATION_DAILY_CAP=10
